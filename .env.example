# Browser-visible Supabase connection (publishable key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-side Supabase connection
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Server-side Resend configuration; never use a VITE_ prefix for secrets
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=MagicSats <nao-responda@your-verified-domain.example>

# Required only when applying Drizzle migrations
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/database

# Optional display configuration; deposits remain disabled until a payment
# provider, payment verification, and secure balance credit flow are implemented.
VITE_BITCOIN_DEPOSIT_ADDRESS=

# Optional CoinGecko key (server-only). Type: demo or pro. Cache 30-60s.
COINGECKO_API_KEY=
COINGECKO_API_KEY_TYPE=demo
COINGECKO_CACHE_SECONDS=45
